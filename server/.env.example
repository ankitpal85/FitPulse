HOST=0.0.0.0
PORT=1337

# -----------------------------------------------
# Strapi Security Keys (generate random strings)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------
APP_KEYS="key1,key2,key3,key4"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# -----------------------------------------------
# Database — LOCAL (SQLite)
# -----------------------------------------------
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# -----------------------------------------------
# Database — PRODUCTION (Supabase PostgreSQL)
# Uncomment these and comment out SQLite above
# -----------------------------------------------
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
# DATABASE_SSL=true

# -----------------------------------------------
# AI Integration
# -----------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------
# CORS — Frontend URL (production only)
# Set this to your Vercel URL on Render dashboard
# -----------------------------------------------
FRONTEND_URL=https://your-app.vercel.app

# -----------------------------------------------
# Cloudinary (optional - for image uploads in production)
# -----------------------------------------------
# CLOUDINARY_NAME=your_cloud_name
# CLOUDINARY_KEY=your_api_key
# CLOUDINARY_SECRET=your_api_secret
